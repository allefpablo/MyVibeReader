# ==============================================================================
# MyVibeReader — Production Environment Variables
# ==============================================================================

# --- Domain & SSL Configuration ---
# Your custom domain or subdomain (e.g. api.yourdomain.com).
# If set to a domain, Caddy automatically obtains and renews Let's Encrypt SSL/TLS certificates!
# If left as :80, it runs over standard HTTP on port 80.
DOMAIN=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# --- Container Image ---
# GitHub Container Registry image tag (automatically updated during release)
APP_IMAGE=ghcr.io/allefpablo/myvibereader-server:latest

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_DB=myvibereader
POSTGRES_USER=myvibereader
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here

# --- Authentication & Security ---
# Minimum 256-bit secret key for HMAC-SHA256 JWT signing
# (Generate with: openssl rand -base64 48)
JWT_SECRET=generate_a_secure_256_bit_random_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# --- S3 Object Storage Configuration ---
# Compatible with AWS S3, Cloudflare R2, DigitalOcean Spaces, or MinIO
S3_BUCKET_NAME=myvibereader-storage-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional: Custom S3 endpoint override (leave empty for standard AWS S3)
# For Cloudflare R2 (10GB free/zero egress): https://<accountid>.r2.cloudflarestorage.com
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=
