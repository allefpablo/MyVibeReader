# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

MAVEN_WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"

# Read distribution URL from properties
DISTRIBUTION_URL=$(grep distributionUrl "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)
WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"
M2_HOME="${M2_HOME:-$HOME/.m2}"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$M2_HOME}"
MAVEN_WRAPPER_CACHE="$MAVEN_USER_HOME/wrapper"

# Determine Maven home from cache
MAVEN_DIST_NAME=$(basename "$DISTRIBUTION_URL" .zip)
MAVEN_HOME="$MAVEN_WRAPPER_CACHE/dists/$MAVEN_DIST_NAME"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven $MAVEN_DIST_NAME ..."
  mkdir -p "$MAVEN_HOME"
  TMP_ZIP="$MAVEN_HOME/dist.zip"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$TMP_ZIP" "$DISTRIBUTION_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$TMP_ZIP" "$DISTRIBUTION_URL"
  else
    echo "ERROR: Neither curl nor wget is available." >&2
    exit 1
  fi
  unzip -q "$TMP_ZIP" -d "$MAVEN_HOME"
  rm -f "$TMP_ZIP"
fi

MAVEN_BIN=$(find "$MAVEN_HOME" -name "mvn" -type f | head -1)
exec "$MAVEN_BIN" "$@"
